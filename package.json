{
  "name": "exposure-stack",
  "version": "0.1.0",
  "description": "A privacy-first PWA that merges three bracketed exposures into one clean image, entirely in your browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "test:fixtures": "node scripts/gen-test-exposures.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e-raw": "node scripts/e2e-raw.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "libraw-wasm": "^1.6.0"
  }
}
